# Copia este archivo como `.env` y completa los valores reales.
# El archivo `.env` está en .gitignore: NUNCA se sube al repositorio.

# --- App ---
PORT=3100
NODE_ENV=development
# Origen permitido por CORS (el frontend Next.js)
FRONTEND_URL=http://localhost:4100

# --- Base de datos ---
# MongoDB local o de Atlas (mongodb+srv://usuario:clave@cluster/estas-en-la-cima)
DATABASE_URI=mongodb://localhost:27017/estas-en-la-cima

# --- Sesión ---
# Secreto para firmar los tokens de acceso (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Duración del token de acceso en segundos (15 min) y de la sesión en días
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# --- Correo (Resend) ---
# Sin API key, los correos (como el código de recuperación) se escriben en el log
RESEND_API_KEY=
EMAIL_FROM="Estás en la cima <onboarding@resend.dev>"
