# Copia este archivo como `.env` y completa los valores reales.
# El archivo `.env` está en .gitignore: NUNCA se sube al repositorio.

# --- App ---
PORT=3100
NODE_ENV=development
# Origen permitido por CORS (el frontend Next.js)
FRONTEND_URL=http://localhost:4100

# --- Base de datos ---
# MongoDB local o de Atlas (mongodb+srv://usuario:clave@cluster/estas-en-la-cima)
DATABASE_URI=mongodb://localhost:27017/estas-en-la-cima
